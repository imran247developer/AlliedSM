@model AlliedSM.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ur-PK">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Recovery — Allied School</title>
    <link rel="stylesheet" href="~/twitter-bootstrap/css/bootstrap.css" />
    <style>
        :root { --l-navy:#131826; --l-blue:#3b6fed; }
        * { box-sizing:border-box; }
        body {
            margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
            font-family:'Segoe UI', system-ui, sans-serif;
            background-image: linear-gradient(160deg, rgba(13,17,25,.88) 0%, rgba(19,24,38,.80) 55%, rgba(59,111,237,.55) 130%), url('/images/allied.jpeg');
            background-size: cover; background-position: center; background-attachment: fixed;
        }
        .card-box {
            background: rgba(255,255,255,.94); backdrop-filter: blur(8px);
            border-radius:16px; padding:34px 32px; width:400px;
            box-shadow: 0 24px 60px rgba(0,0,0,.45); text-align:center;
        }
        .card-box h3 { color:#131826; font-weight:700; }
        .card-box .sub { color:#6b7280; font-size:12.5px; margin-bottom:20px; }
        .form-label { text-align:left; display:block; font-size:12.5px; font-weight:600; color:#374151; }
        .btn-brand { background:var(--l-blue); color:#fff !important; font-weight:600; }
        .btn-brand:hover { background:#2559c7; color:#fff !important; }
        .back-link { display:block; margin-top:14px; font-size:12.5px; color:var(--l-blue); text-decoration:none; }
    </style>
</head>
<body>
<div class="card-box">
    <h3>Password Recovery</h3>
    <div class="sub">Enter your Email, Mobile Number, or ID Card Number (CNIC/B-Form/Registration No.)</div>

    <div asp-validation-summary="All" class="text-danger small mb-2 text-start"></div>

    <form asp-action="ForgotPassword" method="post">
        <div class="mb-3 text-start">
            <label class="form-label">Email / Mobile / ID Card Number</label>
            <input asp-for="Identifier" class="form-control" placeholder="admin@school.com ya 03001234567 or 3230X-XXXXXXX-X" />
        </div>
        <button type="submit" class="btn btn-brand w-100">Recovery Link</button>
        <a class="back-link" asp-action="Login">← Back to Login</a>
    </form>
</div>
</body>
</html>
