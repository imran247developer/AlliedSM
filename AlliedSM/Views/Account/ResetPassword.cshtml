@model AlliedSM.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ur-PK">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password — Allied School</title>
    <link rel="stylesheet" href="~/twitter-bootstrap/css/bootstrap.css" />
    <style>
        :root { --l-blue:#3b6fed; }
        * { box-sizing:border-box; }
        body {
            margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
            font-family:'Segoe UI', system-ui, sans-serif;
            background-image: linear-gradient(160deg, rgba(13,17,25,.88) 0%, rgba(19,24,38,.80) 55%, rgba(59,111,237,.55) 130%), url('/images/allied.jpeg');
            background-size: cover; background-position: center; background-attachment: fixed;
        }
        .card-box {
            background: rgba(255,255,255,.94); backdrop-filter: blur(8px);
            border-radius:16px; padding:34px 32px; width:400px;
            box-shadow: 0 24px 60px rgba(0,0,0,.45); text-align:center;
        }
        .card-box h3 { color:#131826; font-weight:700; margin-bottom:18px; }
        .form-label { text-align:left; display:block; font-size:12.5px; font-weight:600; color:#374151; }
        .btn-brand { background:var(--l-blue); color:#fff !important; font-weight:600; }
        .btn-brand:hover { background:#2559c7; color:#fff !important; }
        .pwd-wrap { position:relative; }
        .pwd-toggle { position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; font-size:13px; color:#6b7280; cursor:pointer; }
    </style>
</head>
<body>
<div class="card-box">
    <h3>Set New Password</h3>
    <div asp-validation-summary="All" class="text-danger small mb-2 text-start"></div>

    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <div class="mb-3 text-start">
            <label class="form-label">New Password</label>
            <div class="pwd-wrap">
                <input asp-for="NewPassword" class="form-control" type="password" id="pwd1" />
                <button type="button" class="pwd-toggle" onclick="toggle('pwd1', this)">👁</button>
            </div>
        </div>
        <div class="mb-3 text-start">
            <label class="form-label">Confirm Password</label>
            <div class="pwd-wrap">
                <input asp-for="ConfirmPassword" class="form-control" type="password" id="pwd2" />
                <button type="button" class="pwd-toggle" onclick="toggle('pwd2', this)">👁</button>
            </div>
        </div>
        <button type="submit" class="btn btn-brand w-100">Reset Password</button>
    </form>
</div>
<script>
    function toggle(id, btn) {
        const input = document.getElementById(id);
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.textContent = showing ? '👁' : '🙈';
    }
</script>
</body>
</html>
