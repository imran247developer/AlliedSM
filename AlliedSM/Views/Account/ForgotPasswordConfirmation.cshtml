@{
    ViewData["Title"] = "Check Your Phone / Email";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ur-PK">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recovery Link Sent — Allied School</title>
    <link rel="stylesheet" href="~/twitter-bootstrap/css/bootstrap.css" />
    <style>
        :root { --l-blue:#3b6fed; }
        * { box-sizing:border-box; }
        body {
            margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
            font-family:'Segoe UI', system-ui, sans-serif;
            background-image: linear-gradient(160deg, rgba(13,17,25,.88) 0%, rgba(19,24,38,.80) 55%, rgba(59,111,237,.55) 130%), url('/images/allied.jpeg');
            background-size: cover; background-position: center; background-attachment: fixed;
        }
        .card-box {
            background: rgba(255,255,255,.94); backdrop-filter: blur(8px);
            border-radius:16px; padding:34px 32px; width:420px;
            box-shadow: 0 24px 60px rgba(0,0,0,.45); text-align:center;
        }
        .card-box h3 { color:#131826; font-weight:700; }
        .card-box p { color:#374151; font-size:13.5px; }
        .back-link { display:inline-block; margin-top:10px; font-size:12.5px; color:var(--l-blue); text-decoration:none; }
        .dev-box { margin-top:16px; padding:12px; background:#fff7e0; border:1px dashed #d1a02a; border-radius:8px; font-size:11.5px; text-align:left; word-break:break-all; }
    </style>
</head>
<body>
<div class="card-box">
    <div style="font-size:38px;">📩</div>
    <h3>If Account Found...</h3>
        <p>If an account exists with the provided Email, Mobile Number, or ID Card, a password reset link has been sent to that email or phone number.   .</p>

    @if (ViewBag.DevResetLink != null)
    {
        <div class="dev-box">
                <strong>Development Mode:</strong> "As live SMS/Email services are not yet connected, the reset link is shown below (this placeholder will disappear once integration is complete).":<br />
            <a href="@ViewBag.DevResetLink">@ViewBag.DevResetLink</a>
        </div>
    }

    <a class="back-link" asp-action="Login">← Back to Login</a>
</div>
</body>
</html>
