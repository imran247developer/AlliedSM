@{
    ViewData["Title"] = "Password Reset";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ur-PK">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset — Allied School</title>
    <link rel="stylesheet" href="~/twitter-bootstrap/css/bootstrap.css" />
    <style>
        :root { --l-blue:#3b6fed; }
        * { box-sizing:border-box; }
        body {
            margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
            font-family:'Segoe UI', system-ui, sans-serif;
            background-image: linear-gradient(160deg, rgba(13,17,25,.88) 0%, rgba(19,24,38,.80) 55%, rgba(59,111,237,.55) 130%), url('/images/allied.jpeg');
            background-size: cover; background-position: center; background-attachment: fixed;
        }
        .card-box {
            background: rgba(255,255,255,.94); backdrop-filter: blur(8px);
            border-radius:16px; padding:34px 32px; width:380px;
            box-shadow: 0 24px 60px rgba(0,0,0,.45); text-align:center;
        }
        .card-box h3 { color:#131826; font-weight:700; }
        .btn-brand { background:var(--l-blue); color:#fff !important; font-weight:600; text-decoration:none; display:inline-block; padding:10px 24px; border-radius:8px; margin-top:14px; }
    </style>
</head>
<body>
<div class="card-box">
    <div style="font-size:38px;">✅</div>
    <h3>Password Updated</h3>
    <p class="text-muted small">Now you can Login with new password.</p>
    <a class="btn-brand" asp-action="Login">Go to Login</a>
</div>
</body>
</html>
