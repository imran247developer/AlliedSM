@model AlliedSM.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-start mb-2">
    <div>
        <h2 class="mb-0">Admin Dashboard</h2>
        <p class="text-muted">@DateTime.Today.ToString("dd MMMM yyyy")</p>
    </div>
    <form asp-controller="Accounts" asp-action="SendDayEndReport" method="post">
        <button type="submit" class="btn btn-outline-dark btn-sm">📩 Send Day-End Report to Principal</button>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body">
        <div class="text-muted small">Total Enrolment</div>
        <div class="fs-4 fw-bold" style="color:#3b6fed;">@Model.TotalEnrolment</div>
    </div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body">
        <div class="text-muted small">Fee Collected Today</div>
        <div class="fs-4 fw-bold text-success">Rs @Model.TodayFeeCollection</div>
    </div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body">
        <div class="text-muted small">Expense Today</div>
        <div class="fs-4 fw-bold text-danger">Rs @Model.TodayExpense</div>
    </div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body">
        <div class="text-muted small">Today's Attendance</div>
        <div class="fs-4 fw-bold">@Model.TodayAttendancePercent%</div>
    </div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5>7-Day Fee Collection</h5>
            <div class="d-flex align-items-end gap-2" style="height:130px;">
                @{ var max = Model.Last7DaysFee.DefaultIfEmpty(new AlliedSM.Models.DailyTotal()).Max(d => d.Amount); max = max == 0 ? 1 : max; }
                @foreach (var d in Model.Last7DaysFee)
                {
                    var h = (int)(d.Amount / max * 100);
                    <div class="text-center" style="flex:1;">
                        <div style="height:100px; display:flex; align-items:end;">
                            <div style="width:100%; height:@(h)px; background:linear-gradient(180deg,#6f8cf5,#131826); border-radius:4px 4px 0 0;" title="Rs @d.Amount"></div>
                        </div>
                        <div class="small text-muted">@d.Date.ToString("dd/MM")</div>
                    </div>
                }
            </div>
        </div></div>
    </div>
    <div class="col-md-5">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5>Student Risk Alerts</h5>
            @if (!Model.RiskAlerts.Any())
            {
                <div class="text-muted small">No Alert All is well.</div>
            }
            @foreach (var alert in Model.RiskAlerts)
            {
                <div class="small border-bottom py-1">⚠ @alert</div>
            }
        </div></div>
    </div>
</div>

<div class="card border-0 shadow-sm"><div class="card-body">
    <h5>Class-wise Snapshot</h5>
    <table class="table table-sm">
        <thead><tr><th>Class</th><th>Students</th><th>Attendance</th><th>Fee Collected</th><th>Defaulters</th></tr></thead>
        <tbody>
        @foreach (var c in Model.ClassSnapshots)
        {
            <tr><td>@c.ClassName</td><td>@c.Students</td><td>@c.AttendancePercent%</td><td>Rs @c.FeeCollected</td><td>@c.Defaulters</td></tr>
        }
        </tbody>
    </table>
</div></div>
