@model AlliedSM.Models.ParentDashboardViewModel
@{
    ViewData["Title"] = "Parent Dashboard";
}

@if (Model.Child == null)
{
    <div class="alert alert-warning">
        There is no child linked to your login yet — please contact the Admin so that 'Link to Student ID' can be set in Login (Module 2)..
    </div>
}
else
{
    <h2>@Model.Child.StudentName <small class="text-muted">(@Model.Child.RegistrationNo)</small></h2>
    <p class="text-muted">Class @Model.Child.SchoolClass?.ClassName — @Model.Child.Section?.SectionName</p>

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">
            <div class="text-muted small">Attendance (last 30 days)</div>
            <div class="fs-4 fw-bold" style="color:#5a1723;">@Model.AttendancePercent%</div>
        </div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">
            <div class="text-muted small">Fee Status</div>
            <div class="fs-4 fw-bold @(Model.FeeStatus == "Paid" ? "text-success" : "text-danger")">@Model.FeeStatus</div>
        </div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">
            <div class="text-muted small">Amount Due</div>
            <div class="fs-4 fw-bold">Rs @Model.FeeDueAmount</div>
        </div></div></div>
    </div>

    <div class="card border-0 shadow-sm"><div class="card-body">
        <h5>Recent Marks</h5>
        @if (!Model.RecentMarks.Any())
        {
            <div class="text-muted small">No Marks uploaded yet.</div>
        }
        <table class="table table-sm">
            <thead><tr><th>Subject</th><th>Total</th><th>Obtained</th><th>Grade</th></tr></thead>
            <tbody>
            @foreach (var m in Model.RecentMarks)
            {
                <tr><td>@m.Exam?.Subject?.SubjectName</td><td>@m.Exam?.TotalMarks</td><td>@m.ObtainedMarks</td><td>@m.Grade</td></tr>
            }
            </tbody>
        </table>
    </div></div>
}
