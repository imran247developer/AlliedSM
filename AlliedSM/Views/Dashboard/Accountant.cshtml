@model AlliedSM.Models.AccountantDashboardViewModel
@{
    ViewData["Title"] = "Accountant Dashboard";
}

<h2>Accounts Overview</h2>
<p class="text-muted">@DateTime.Today.ToString("dd MMMM yyyy")</p>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body">
        <div class="text-muted small">Today's Income</div>
        <div class="fs-4 fw-bold text-success">Rs @Model.TodayIncome</div>
    </div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body">
        <div class="text-muted small">Today's Expense</div>
        <div class="fs-4 fw-bold text-danger">Rs @Model.TodayExpense</div>
    </div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body">
        <div class="text-muted small">Net Balance</div>
        <div class="fs-4 fw-bold" style="color:#5a1723;">Rs @Model.NetBalance</div>
    </div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body">
        <div class="text-muted small">Defaulters</div>
        <div class="fs-4 fw-bold text-warning">@Model.DefaultersCount</div>
    </div></div></div>
</div>

<div class="card border-0 shadow-sm mb-4"><div class="card-body">
    <h5>Recent Expenses</h5>
    @foreach (var e in Model.RecentExpenses)
    {
        <div class="d-flex justify-content-between border-bottom py-1 small">
            <span>@e.Description</span><span>Rs @e.Amount</span>
        </div>
    }
</div></div>

<a asp-controller="Fee" asp-action="Index" class="btn btn-primary me-2">Fee & Challans</a>
<a asp-controller="Expenses" asp-action="Index" class="btn btn-outline-dark me-2">Expense Ledger</a>
<a asp-controller="Payroll" asp-action="Index" class="btn btn-outline-dark">Payroll</a>
