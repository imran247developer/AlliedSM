@model AlliedSM.Models.Exam
@{
    ViewData["Title"] = "Edit Exam";
}
<h2>Edit Exam</h2>
<form asp-action="Edit" method="post" class="row g-3" style="max-width:450px;">
    <input type="hidden" asp-for="ExamId" />
    <div class="col-12"><label class="form-label">Exam Name</label><input asp-for="ExamName" class="form-control" /></div>
    <div class="col-12"><label class="form-label">Class</label><select asp-for="SchoolClassId" class="form-select" asp-items="ViewBag.SchoolClassId"></select></div>
    <div class="col-12"><label class="form-label">Subject</label><select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId"></select></div>
    <div class="col-12"><label class="form-label">Total Marks</label><input asp-for="TotalMarks" class="form-control" /></div>

    <div class="col-12 mt-2">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
