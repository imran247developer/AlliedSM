@{
    ViewData["Title"] = "Import Biometric Log";
}

<h2>Import Machine Log (.csv)</h2>
<p class="text-muted">Upload the CSV file exported from the fingerprint machine. Each row...: <code>CNIC, Date, CheckIn, CheckOut</code></p>
<p class="small text-muted">For Example: <code>35201-1234567-1,2026-09-19,08:22,15:40</code> — header row (CNIC,Date,CheckIn,CheckOut) is automatically skipped during import.</p>

<form asp-action="Import" method="post" enctype="multipart/form-data" class="row g-3" style="max-width:450px;">
    <div class="col-12">
        <input type="file" name="csvFile" class="form-control" accept=".csv" required />
    </div>
    <div class="col-12 mt-2">
        <button type="submit" class="btn btn-primary">Import</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<div class="alert alert-info mt-4 small">
    <strong>Rules (can changed in Program.cs):</strong><br />
    Shift Start: 8:00 AM, Grace: 15 minutes (8:15 not count it late)<br />
    Late Fine: Rs 20 after 10 minute late<br />
    Shift End: 2:00 PM — no Over time.
</div>
