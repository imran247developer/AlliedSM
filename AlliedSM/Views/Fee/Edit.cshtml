@model AlliedSM.Models.FeeChallan
@{
    ViewData["Title"] = "Edit Challan";
}

<h2>Edit Challan — @Model.VoucherNo</h2>

<form asp-action="Edit" method="post" class="row g-3" style="max-width:500px;">
    <input type="hidden" asp-for="FeeChallanId" />
    <input type="hidden" asp-for="StudentId" />
    <div class="col-6"><label class="form-label">Tuition Fee</label><input asp-for="TuitionFee" class="form-control" /></div>
    <div class="col-6"><label class="form-label">Exam Fee</label><input asp-for="ExamFee" class="form-control" /></div>
    <div class="col-6"><label class="form-label">Lab Fee</label><input asp-for="LabFee" class="form-control" /></div>
    <div class="col-6"><label class="form-label">Admission Fee</label><input asp-for="AdmissionFee" class="form-control" /></div>
    <div class="col-6"><label class="form-label">Transport Fee</label><input asp-for="TransportFee" class="form-control" /></div>
    <div class="col-6"><label class="form-label">Arrears</label><input asp-for="ArrearsAmount" class="form-control" /></div>
    <div class="col-6"><label class="form-label">Late Fee Fine</label><input asp-for="LateFeeFine" class="form-control" /></div>
    <div class="col-12"><label class="form-label">Due Date</label><input asp-for="DueDate" class="form-control" type="date" /></div>

    <div class="col-12 mt-2">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
