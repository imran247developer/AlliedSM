@model AlliedSM.Models.SchoolClass
@{
    ViewData["Title"] = "Add Class";
}
<h2>Add Class</h2>
<form asp-action="Create" method="post" class="row g-3" style="max-width:420px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-12">
        <label class="form-label">Class Name</label>
        <input asp-for="ClassName" class="form-control" placeholder="e.g. Class 9" />
    </div>
    <div class="col-12">
        <label class="form-label">Display Order</label>
        <input asp-for="DisplayOrder" class="form-control" placeholder="Sorting ke liye — jaise Nursery=0, Class 1=1..." />
    </div>
    <div class="col-12 mt-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
