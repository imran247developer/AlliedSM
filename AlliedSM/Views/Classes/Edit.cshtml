@model AlliedSM.Models.SchoolClass
@{
    ViewData["Title"] = "Edit Class";
}
<h2>Edit Class</h2>
<form asp-action="Edit" method="post" class="row g-3" style="max-width:420px;">
    <input type="hidden" asp-for="SchoolClassId" />
    <div class="col-12">
        <label class="form-label">Class Name</label>
        <input asp-for="ClassName" class="form-control" />
    </div>
    <div class="col-12">
        <label class="form-label">Display Order</label>
        <input asp-for="DisplayOrder" class="form-control" />
    </div>
    <div class="col-12 mt-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
